{
  "name": "wabot",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=@wabot/web",
    "start:api": "pnpm --filter @wabot/api start",
    "start:web": "pnpm --filter @wabot/web start",
    "lint": "turbo run lint --filter=@wabot/web",
    "clean": "pnpm -r --if-present clean",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
