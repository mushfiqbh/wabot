{
  "name": "@wabot/api",
  "version": "0.1.9",
  "description": "This is a simple and powerful WhatsApp bot built using the [Baileys](https://github.com/WhiskeySockets/Baileys) library, an unofficial WhatsApp Web API for Node.js. It allows you to automate replies, handle user messages, and create intelligent bot logic.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "automation",
    "nodejs"
  ],
  "author": "nexoscreator",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@supabase/supabase-js": "^2.106.2",
    "@whiskeysockets/baileys": "^6.7.18",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.17.0",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.32.6",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
